# ==============================================================================
# Science with Laknath ERP - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Engine Selection ('mysql' for Cloud MySQL DB, 'json' for Local JSON fallback)
DB_TYPE=mysql

# ==============================================================================
# Cloud MySQL Database Credentials
# Compatible with: TiDB Cloud Serverless (Free), Aiven MySQL Free, Clever Cloud, Railway
# ==============================================================================
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_username.root
DB_PASSWORD=your_db_strong_password
DB_NAME=science_lms_db

# SSL/TLS Security (Set to true for cloud hosting like TiDB Cloud, Aiven, Railway, AWS RDS)
DB_SSL=true

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true

# Optional: Direct MySQL Connection URI (If your cloud host provides a single URI string)
# MYSQL_URI=mysql://user:pass@host:port/dbname?ssl={"rejectUnauthorized":true}

# Administrator Security & JWT Secret (Optional fallback)
JWT_SECRET=science_with_laknath_super_secure_key_2026
